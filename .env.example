# Copy this file to .env (next to docker-compose.yml) and fill in what you need.
# Everything is optional. .env is git-ignored: never commit real keys.

# --- MCP server at /mcp ---
# Empty = no token check. When set, MCP clients must send "Authorization: Bearer <token>".
IRTRACK_MCP_TOKEN=

# --- AI-assisted setup: configure one or more providers ---

# Anthropic (Claude). Model default: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI. Model default: gpt-4.1
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter. The model is chosen on the setup page; OPENROUTER_MODEL only preselects one.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ollama (local: your documents never leave your machine). The model is chosen on the setup page.
# Ollama running on the same machine as Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- AI assistant (portal and Admin Console) ---
# Provider for the assistant: anthropic, openai, openrouter or ollama. The model must support tool calling.
# Empty = the first configured provider that has a model (for OpenRouter/Ollama that means OPENROUTER_MODEL/OLLAMA_MODEL).
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
